import requests
from src.utils import log_error

class CalderaClient:
    def __init__(self, base_url, api_key):
        self.base = base_url.rstrip("/")
        self.headers = {"KEY": api_key}

    def get_agents(self):
        res = requests.get(f"{self.base}/api/v2/agents", headers=self.headers)
        return res.json() if res.status_code == 200 else []

    def execute_ability(self, agent_id, ability_id):
        payload = {"paw": agent_id, "ability_id": ability_id}
        res = requests.post(f"{self.base}/api/v2/abilities/execute", headers=self.headers, json=payload)

        if res.status_code == 200:
            return True, res.json()
        else:
            log_error(f"Execution failed: {res.text}")
            return False, None
